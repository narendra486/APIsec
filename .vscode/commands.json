{
  "auto_run_all": true,
  "commands": [
    {
      "name": "run_unit_tests",
      "command": "PYTHONPATH=. python3 scripts/run_unit_tests.py",
      "auto_run": true,
      "patterns": ["src/**", "tests/**", "scripts/**"]
    },
    {
      "name": "start_watcher",
      "command": "PYTHONPATH=. python3 scripts/auto_run_on_change.py",
      "auto_run": false,
      "patterns": []
    }
  ]
}